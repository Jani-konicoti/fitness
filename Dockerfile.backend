FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY backend/main.py /app/backend/main.py
RUN mkdir -p /data && useradd --system --uid 10001 --home-dir /nonexistent fitness && chown fitness:fitness /data
USER fitness
ENV DATABASE_PATH=/data/fitness.db
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "172.30.0.2"]
